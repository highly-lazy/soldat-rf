<li class="art__card">
	<a class="art__link" href="{link}">
		<span class="art__photo"><img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-lazy-src="{image-1}" alt="" width="440" height="190" decoding="async"></span>
		<span class="art__body">
			<span class="art__date">{date}</span>
			<span class="art__name">{title}</span>
		</span>
		<span class="art__more">Смотреть подробнее <span class="btn__arrow"><svg class="icon-arrow-ne" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M1.65 10.35 10.35 1.65" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M3.05 1.65h7.3v7.3" stroke="currentColor" stroke-width="1.3" stroke-linejoin="bevel"/></svg></span></span>
	</a>
</li>
