<article class="post-card">
	[full-link]<a class="post-card__media" href="{full-link}">[/full-link]
		[thumb-url]<img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-lazy-src="{thumb-url}" alt="{title}" loading="lazy" width="400" height="240" decoding="async">[/thumb-url]
	[full-link]</a>[/full-link]
	<div class="post-card__body">
		<h2 class="post-card__title h4">{title}</h2>
		<div class="post-card__text">{short-story limit="200"}</div>
		<div class="post-card__meta">
			<time datetime="{date=Y-m-d}">{date=j F Y}</time>
			<span class="post-card__views">{views}</span>
		</div>
		[full-link]<a class="btn btn--ghost post-card__more" href="{full-link}">Читать</a>[/full-link]
	</div>
</article>
