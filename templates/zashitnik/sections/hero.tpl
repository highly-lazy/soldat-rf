<section class="hero" aria-labelledby="hero-title">
	<!-- фон: снимок неба + осветляющая пелена rgba(255,255,255,.44) как в макете -->
	<div class="hero__bg" aria-hidden="true">
		<img class="hero__bg-img" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-lazy-src="{theme}/images/df4942f1911a0e8ce012cec5020bf2af02062bae.webp" alt="" width="1600" height="900" fetchpriority="high" decoding="async">
		<span class="hero__bg-veil"></span>
	</div>

	<img class="hero__soldier" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-lazy-src="{theme}/images/b3709cddccf382b24c959f9daa3e87fd42bfb0de.webp" alt="Военнослужащий по контракту" width="887" height="1112" fetchpriority="high" decoding="async">

	<div class="hero__inner container">
		<div class="hero__card">
			<h1 class="hero__title" id="hero-title">
				<span>Контракт на СВО</span>
				<span>Гражданину Беларуси</span>
			</h1>

			<div class="hero__text">
				<p>Официальное сопровождение граждан <br>Беларуси / РБ по подписанию контракта на СВО:</p>
				<ul class="hero__list">
					<li>консультация</li>
					<li>проверка документов</li>
					<li>прохождение ВВК</li>
					<li>поездка в Москву</li>
					<li>оформление и разъяснение выплат.</li>
				</ul>
			</div>

			<a class="hero__btn" href="#contact">
				<span class="hero__btn-label">Оставить заявку</span>
				<span class="hero__btn-icon" aria-hidden="true">
					<svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M1 6h9m0 0L6.4 2.4M10 6l-3.6 3.6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
				</span>
			</a>
		</div>

		<ul class="hero__stats">
			<li class="hero__stat">
				<span class="hero__stat-icon" aria-hidden="true">
					<img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-lazy-src="{theme}/images/213043fae087be6e64e1b990e5f922ce6a751558.svg" alt="" width="53" height="37" decoding="async">
				</span>
				<b class="hero__stat-value">2 300 000 ₽</b>
				<span class="hero__stat-label">при заключении контракта</span>
			</li>
			<li class="hero__stat">
				<span class="hero__stat-icon" aria-hidden="true">
					<img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-lazy-src="{theme}/images/0ffe0d9fccdefb257cc3c4e4dba79a0786127ded.svg" alt="" width="50" height="51" decoding="async">
				</span>
				<b class="hero__stat-value">от 260 000 ₽</b>
				<span class="hero__stat-label">денежное довольствие</span>
			</li>
		</ul>

		<p class="hero__note">
			<img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-lazy-src="{theme}/images/flag-by.svg" alt="Флаг Республики Беларусь" width="39" height="19" decoding="async">
			<span>Республика Беларусь / Официальное оформление</span>
		</p>
	</div>
</section>
